{
  "name": "minimum",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix spacetimedb && npm install --prefix client",
    "db:start": "spacetime start",
    "db:publish": "spacetime publish --module-path spacetimedb --server local minimum -y",
    "db:publish:reset": "spacetime publish --module-path spacetimedb --server local minimum -y --delete-data",
    "db:publish:cloud": "spacetime publish --module-path spacetimedb --server maincloud minimum -y",
    "db:generate": "spacetime generate --lang typescript --out-dir client/src/module_bindings --module-path spacetimedb",
    "db:logs": "spacetime logs --server local minimum",
    "client:dev": "npm run dev --prefix client"
  }
}
