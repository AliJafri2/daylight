{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --prefix worker",
    "watchPatterns": [
      "worker/**",
      "shared/**",
      "railway.json",
      "package.json"
    ]
  },
  "deploy": {
    "startCommand": "npm run start:prod --prefix worker",
    "restartPolicyType": "ALWAYS"
  }
}
